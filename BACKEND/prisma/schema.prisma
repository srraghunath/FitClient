// FitBond Production Schema: Trainer/Client Platform (Template-based)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  role           String    // Replaced UserRole enum
  fullName       String
  specialization String?
  goals          String?

  clients           ClientTrainer[] @relation("TrainerClients")
  trainerLink       ClientTrainer? @relation("ClientTrainerLink")
  weeklySchedules   WeeklyScheduleTemplate[]
  activityLogs      ClientActivityLog[]
  messagesSent      Message[]       @relation("Sender")
  messagesReceived  Message[]       @relation("Receiver")
  sessionsAsTrainer Session[]       @relation("TrainerSessions")
  sessionsAsClient  Session[]       @relation("ClientSessions")
}

model ClientTrainer {
  id        String @id @default(cuid())
  trainerId String
  clientId  String @unique
  level     String @default("Beginner")
  isActive  Boolean @default(true)

  trainer User @relation("TrainerClients", fields: [trainerId], references: [id])
  client  User @relation("ClientTrainerLink", fields: [clientId], references: [id])

  @@unique([trainerId, clientId])
}

// --- Schedule Template Models (RECURRING LOGIC) ---

model WeeklyScheduleTemplate {
  id                 String   @id @default(cuid())
  clientId           String
  dayOfWeek          String   // Replaced DayOfWeek enum
  sleepTargetHours   Float?
  waterTargetLiters  Float?
  cardioPlanText     String?

  client               User                        @relation(fields: [clientId], references: [id])
  scheduledExercises   ScheduledTemplateExercise[]
  scheduledMealItems   ScheduledTemplateMealItem[]

  @@unique([clientId, dayOfWeek])
}

model ScheduledTemplateExercise {
  id         String @id @default(cuid())
  templateId String
  exerciseId String
  sets       Int
  reps       String

  template WeeklyScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise               @relation(fields: [exerciseId], references: [id])
}

model ScheduledTemplateMealItem {
  id           String   @id @default(cuid())
  templateId   String
  foodItemId   String
  mealTime     String   // Replaced MealTime enum
  quantityText String?

  template WeeklyScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  foodItem FoodItem               @relation(fields: [foodItemId], references: [id])
}

// --- Activity Log Model (HISTORICAL TRACKING) ---

model ClientActivityLog {
  id                 String   @id @default(cuid())
  clientId           String
  date               DateTime
  isWorkoutCompleted Boolean  @default(false)
  isDietCompleted    Boolean  @default(false)
  isCardioCompleted  Boolean  @default(false)
  isWaterGoalMet     Boolean  @default(false)
  isSleepGoalMet     Boolean  @default(false)

  client User @relation(fields: [clientId], references: [id])

  @@unique([clientId, date])
}

// --- Library Models ---

model Exercise {
  id          String                        @id @default(cuid())
  name        String                        @unique
  bodyPart    String                        // Replaced ExerciseBodyPart enum
  description String?
  scheduled   ScheduledTemplateExercise[]
}

model FoodItem {
  id        String                      @id @default(cuid())
  name      String                      @unique
  calories  Int
  protein   Float
  carbs     Float
  fat       Float
  scheduled ScheduledTemplateMealItem[]
}

// --- Communication and Session Models ---

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String
  startTime DateTime
  endTime   DateTime
  notes     String?

  trainer User @relation("TrainerSessions", fields: [trainerId], references: [id])
  client  User @relation("ClientSessions", fields: [clientId], references: [id])
}
